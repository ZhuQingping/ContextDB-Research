flowchart TB
    Console["Console"] -- "管理申请" --> Control["管理面（已有管控后端）<br/>用户认证与授权"]
    Agent["Agent / 应用"]
    subgraph Tenant["一个华为云租户的独享部署"]
        direction TB
        subgraph App["Hindsight 计算引擎：API 与 Worker 并列"]
            direction LR
            API["Hindsight 计算节点（API）<br/>管理 REST：管理 Key + 权限复核<br/>原生接口：用户 Key + Bank 范围"]
            Worker["Hindsight Worker + 同版本扩展<br/>原生任务 / 记忆整理 / 页面刷新<br/>按空间 schema 处理数据"]
        end
        PG[("同一个 RDS PG 数据库<br/>ctxdb_meta：空间 / 用户 / Key<br/>管理任务 / 管理操作审计<br/>空间 A schema：Bank / 数据 / 任务<br/>空间 B schema：Bank / 数据 / 任务<br/>表与索引分开，PG 资源共享")]
        API -- "读写元信息与数据 / 提交任务" --> PG
        Worker -- "枚举空间 schema / 处理原生任务" --> PG
    end
    Control -- "管理 REST<br/>管理 Key + 可信操作人" --> API
    Agent -- "原生 REST / MCP<br/>用户 API Key" --> API
