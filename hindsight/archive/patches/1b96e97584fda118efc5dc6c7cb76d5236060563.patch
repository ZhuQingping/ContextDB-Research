+async def test_active_operation_constraint_locks_parent_against_concurrent_sql_delete(repository):
+    space = await ready_workspace(repository, "constraint_lock")
+    async with repository.pool.acquire() as first, repository.pool.acquire() as second:
+        transaction = first.transaction()
+        await transaction.start()
+        deletion = None
+        try:
+            await first.execute(
+                "INSERT INTO ctxdb_meta.management_operations(operation_id,workspace_id,action,target_id,idempotency_key,request_hash) VALUES(repeat('c',32),$1,'delete_workspace',$1,'constraint-lock',repeat('f',64))",
+                space.workspace_id,
+            )
+            await first.execute("SET CONSTRAINTS ALL IMMEDIATE")
+            deletion = asyncio.create_task(
+                second.execute("DELETE FROM ctxdb_meta.workspaces WHERE workspace_id=$1", space.workspace_id)
+            )
+            with pytest.raises(TimeoutError):
+                await asyncio.wait_for(asyncio.shield(deletion), 0.1)
+            await transaction.commit()
+            with pytest.raises(asyncpg.ForeignKeyViolationError):
+                await deletion
+        finally:
+            if first.is_in_transaction():
+                await transaction.rollback()
+            if deletion is not None and not deletion.done():
+                deletion.cancel()
+                await asyncio.gather(deletion, return_exceptions=True)
+
