+"""Foreground process launch for the existing node Agent or service supervisor."""
+
+from __future__ import annotations
+
+import os
+import sys
+from pathlib import Path
+from typing import Literal
+
+from .artifacts import verify_ui_build
+from .bootstrap import load_deployment_secrets
+
+
+def launch(component: Literal["api", "worker", "ui"], directory: Path, source_root: Path) -> None:
+    if component == "ui":
+        verify_ui_build(source_root)
+        # Build/server processes receive UI-only configuration, never PG/model
+        # credentials or the HMAC pepper from a shared operator shell.
+        system_keys = {
+            "PATH",
+            "HOME",
+            "TMPDIR",
+            "TMP",
+            "TEMP",
+            "LANG",
+            "LC_ALL",
+            "TZ",
+            "NODE_ENV",
+            "NODE_OPTIONS",
+            "NODE_EXTRA_CA_CERTS",
+            "SSL_CERT_FILE",
+            "SSL_CERT_DIR",
+            "HTTP_PROXY",
+            "HTTPS_PROXY",
+            "NO_PROXY",
+        }
+        environment = {
+            key: value
+            for key, value in os.environ.items()
+            if key in system_keys or key.startswith(("HINDSIGHT_CP_", "NEXT_PUBLIC_"))
+        }
+        os.environ.clear()
+        os.environ.update(environment)
+        load_deployment_secrets(directory, "ui")
+        server = source_root / "hindsight-control-plane" / "standalone" / "server.js"
+        if not server.is_file():
+            raise ValueError("Build the matching UI standalone artifact before starting it")
+        os.environ["HOSTNAME"] = os.environ.get("HINDSIGHT_CP_HOST", "0.0.0.0")
+        os.environ["PORT"] = os.environ.get("HINDSIGHT_CP_PORT", "9999")
+        os.execvp("node", ["node", str(server)])
+    load_deployment_secrets(directory, "api")
+    # API/Worker never need the UI login password or its backend Admin Key.
+    for key in (
+        "HINDSIGHT_CP_ACCESS_KEY",
+        "HINDSIGHT_CP_DATAPLANE_API_KEY",
+    ):
+        os.environ.pop(key, None)
+    os.environ["PYTHON_DOTENV_DISABLED"] = "1"
+    arguments = [sys.executable, "-m", "hindsight_api.worker.main"]
+    if component == "api":
+        from hindsight_api.config import get_config
+
+        config = get_config()
+        arguments = [
+            sys.executable,
+            "-m",
+            "uvicorn",
+            "hindsight_ext_contextdb.asgi:create_app",
+            "--factory",
+            "--host",
+            os.environ.get("HINDSIGHT_API_HOST", "0.0.0.0"),
+            "--port",
+            os.environ.get("HINDSIGHT_API_PORT", "8888"),
+            "--log-level",
+            config.log_level,
+            "--access-log" if config.access_log else "--no-access-log",
+            "--workers",
+            str(config.workers),
+            # Match the native CLI: forwarded identity is opt-in, not trusted
+            # implicitly because uvicorn's CLI enables proxy headers by default.
+            "--no-proxy-headers",
+            "--ws",
+            "wsproto",
+            "--timeout-keep-alive",
+            "30",
+            "--timeout-graceful-shutdown",
+            "5",
+        ]
+    os.execv(sys.executable, arguments)
diff --git a/hindsight-extensions/contextdb-service/hindsight_ext_contextdb/lifecycle.py b/hindsight-extensions/contextdb-service/hindsight_ext_contextdb/lifecycle.py
new file mode 100644
index 0000000000000000000000000000000000000000..8c788117b0caf34f516dc9b6ff776b320c14ce24
--- /dev/null
+++ b/hindsight-extensions/contextdb-service/hindsight_ext_contextdb/lifecycle.py
@@ -0,0 +1,207 @@
+"""Recoverable workspace provisioning within the API process, not a new service."""
+
+from __future__ import annotations
+
+import asyncio
+import contextlib
+import logging
+import os
+import secrets
+import socket
+import time
+from typing import TYPE_CHECKING
+
+from hindsight_api.extensions.context import ExtensionContext
+from hindsight_api.models import RequestContext
+from pydantic import BaseModel
+
+from .admission import initializing_bank
+from .models import ManagementOperation, ServiceError
+from .repository import Repository
+
+if TYPE_CHECKING:
+    from hindsight_api import MemoryEngine
+
+logger = logging.getLogger(__name__)
+
+
+class OperationCount(BaseModel):
+    total: int
+
+
+class Lifecycle:
+    def __init__(self, repository: Repository, memory: MemoryEngine, context: ExtensionContext) -> None:
+        self.repository = repository
+        self.memory = memory
+        self.context = context
+        self._task: asyncio.Task[None] | None = None
+        self._last_prune = 0.0
+
+    def start(self) -> None:
+        self._task = asyncio.create_task(self.run(), name="contextdb-workspace-lifecycle")
+
+    async def stop(self) -> None:
+        if self._task is not None:
+            self._task.cancel()
+            with contextlib.suppress(asyncio.CancelledError):
+                await self._task
+            self._task = None
+
+    async def _heartbeat(self, operation: ManagementOperation) -> None:
+        while True:
+            await asyncio.sleep(10)
+            if not await self.repository.renew_operation(operation):
+                raise ServiceError(409, "lease_lost", "Workspace operation lease was lost")
+
+    async def run(self) -> None:
+        while True:
+            try:
+                if time.monotonic() - self._last_prune >= 60:
+                    await self.repository.prune_operations()
+                    self._last_prune = time.monotonic()
+                operation = await self.repository.claim_operation()
+                if operation is None:
+                    await asyncio.sleep(0.5)
+                    continue
+                await self.execute(operation)
+            except asyncio.CancelledError:
+                raise
+            except Exception:
+                # DB failures must not permanently kill the recovery loop. Do not
+                # log exceptions containing DSNs, payloads or customer credentials.
+                logger.warning("ContextDB lifecycle sweep failed; retrying")
+                await asyncio.sleep(1)
+
+    async def execute(self, operation: ManagementOperation) -> None:
+        try:
+            # Cancel coroutine work when ownership is lost. Metadata completion
+            # is fenced; a migration thread itself is not cancellable (see below).
+            async with asyncio.TaskGroup() as group:
+                heartbeat = group.create_task(self._heartbeat(operation))
+                try:
+                    completed = await self._apply(operation)
+                    if completed:
+                        await self.repository.complete_operation(operation)
+                finally:
+                    heartbeat.cancel()
+        except asyncio.CancelledError:
+            # Leave the durable lease for another replica after expiry. Cancelling
+            # a migration thread cannot undo DDL that already committed.
+            raise
+        except Exception:
+            logger.warning("ContextDB workspace operation failed: %s", operation.operation_id)
+            await self.repository.fail_operation(operation)
+
+    async def _apply(self, operation: ManagementOperation) -> bool:
+        admission_id = secrets.token_hex(16)
+        await self.repository.register_lifecycle_admission(operation, admission_id)
+        logger.info(
+            "ContextDB lifecycle executor operation=%s admission=%s host=%s pid=%s",
+            operation.operation_id,
+            admission_id,
+            socket.gethostname(),
+            os.getpid(),
+        )
+        try:
+            return await self._apply_guarded(operation, admission_id)
+        finally:
+            # _apply_guarded drains shielded migration threads before returning.
+            # A process crash cannot run this cleanup and deliberately leaves the
+            # persisted barrier, blocking physical schema/name reuse.
+            await self.repository.finish_admission(admission_id, operation.lease_token or "", interrupted=False)
+
+    async def _apply_guarded(self, operation: ManagementOperation, admission_id: str) -> bool:
+        from hindsight_api.engine.memory_engine import _current_schema
+
+        if not operation.lease_token or not await self.repository.operation_is_owned(
+            operation.operation_id, operation.lease_token, operation.action, operation.workspace_id
+        ):
+            raise ServiceError(409, "lease_lost", "Workspace operation lease was lost")
+        workspace = await self.repository.operation_workspace(operation)
+        await self.repository.verify_workspace_schema(workspace.schema_name)
+        token = _current_schema.set(workspace.schema_name)
+        context = RequestContext(
+            internal=True,
+            tenant_id=workspace.workspace_id,
+            allowed_bank_ids=[workspace.bank_id],
+            extra_headers={
+                "ctxdb-internal-purpose": operation.action,
+                "ctxdb-operation-id": operation.operation_id,
+                "ctxdb-lease-token": operation.lease_token,
+            },
+        )
+        try:
+            if operation.action == "create_workspace":
+                migration = asyncio.create_task(self.context.run_migration(workspace.schema_name))
+                try:
+                    await asyncio.shield(migration)
+                except asyncio.CancelledError as cancelled:
+                    # asyncio.to_thread keeps running after cancellation. Retain
+                    # coroutine alive until it really exits. No long metadata
+                    # transaction may span DDL: CREATE INDEX CONCURRENTLY can
+                    # wait for its old snapshot and deadlock provisioning.
+                    # Native migrations keep their own schema serialization;
+                    # renew below prevents an expired owner from creating Bank.
+                    while not migration.done():
+                        # A second shutdown/lease-loss cancellation must not
+                        # make stop() return while this migration still runs.
+                        with contextlib.suppress(asyncio.CancelledError, Exception):
+                            await asyncio.shield(migration)
+                    # Retrieve a possible migration exception, then preserve
+                    # cancellation rather than continuing to Bank creation.
+                    with contextlib.suppress(asyncio.CancelledError, Exception):
+                        migration.result()
+                    raise cancelled
+                if not await self.repository.renew_operation(operation):
+                    raise ServiceError(409, "lease_lost", "Workspace operation lease was lost")
+                with initializing_bank(
+                    workspace.schema_name, workspace.bank_id, operation.operation_id, operation.lease_token
+                ):
+                    await self.memory.update_bank(workspace.bank_id, name=workspace.name, request_context=context)
+                    if await self.memory.get_bank_profile(workspace.bank_id, request_context=context) is None:
+                        raise RuntimeError("Bank provisioning verification failed")
+            else:
+                # A failed create can have no bank table yet; teardown still
+                # cleans its partial schema after all executors have drained.
+                bank_present = (
+                    await self.repository.bank_table_exists(workspace.schema_name)
+                    and await self.memory.get_bank_profile(workspace.bank_id, request_context=context) is not None
+                )
+                if bank_present:
+                    # One COUNT snapshot, not separate pending/processing reads:
+                    # a processing parent can enqueue a child between two reads.
+                    page = OperationCount.model_validate(
+                        await self.memory.list_operations(
+                            workspace.bank_id,
+                            statuses=["pending", "processing"],
+                            limit=1,
+                            offset=0,
+                            request_context=context,
+                        )
+                    )
+                    if page.total:
+                        await self.repository.defer_operation(operation, reason="waiting_for_tasks")
+                        return False
+                # Check committed admissions AFTER the queue snapshot: a parent
+                # may finish while its continuation has already registered but
+                # has not yet committed a child row. In a deleting space no new
+                # queue work starts without such a processing parent.
+                # Session loss/crashes retain these barriers; never time them out.
+                if await self.repository.has_outstanding_admissions(workspace.workspace_id, excluding=admission_id):
+                    await self.repository.defer_operation(operation, reason="waiting_for_admissions")
+                    return False
+                if bank_present:
+                    await self.memory.delete_bank(workspace.bank_id, request_context=context)
+                # Core intentionally treats file cleanup as best effort. A whole
+                # workspace must not report success while its registered prefix
+                # could not be reclaimed; retry remains possible without a bank row.
+                from hindsight_api.engine.storage import PostgreSQLFileStorage, bank_storage_prefix
+
+                storage = self.memory._file_storage
+                if not isinstance(storage, PostgreSQLFileStorage) or await self.repository.file_table_exists(
+                    workspace.schema_name
+                ):
+                    await storage.delete_prefix(bank_storage_prefix(workspace.bank_id, workspace.schema_name))
+            return True
+        finally:
+            _current_schema.reset(token)
diff --git a/hindsight-extensions/contextdb-service/hindsight_ext_contextdb/mcp.py b/hindsight-extensions/contextdb-service/hindsight_ext_contextdb/mcp.py
new file mode 100644
index 0000000000000000000000000000000000000000..8d6198a7e184ce4a740aeba8112989a89818501d
--- /dev/null
+++ b/hindsight-extensions/contextdb-service/hindsight_ext_contextdb/mcp.py
@@ -0,0 +1,177 @@
+"""Route existing MCP tools by their actual Bank without rewriting native tools."""
+
+from __future__ import annotations
+
+from collections.abc import Sequence
+from contextlib import AbstractContextManager
+from typing import TYPE_CHECKING, Any, Callable, cast
+
+import mcp.types as mt
+from fastmcp import FastMCP
+from fastmcp.exceptions import ToolError
+from fastmcp.server.dependencies import get_http_request
+from fastmcp.server.middleware import CallNext, Middleware, MiddlewareContext
+from fastmcp.tools.base import Tool, ToolResult
+from hindsight_api.extensions.mcp import MCPExtension
+
+from .admission import restore_admission
+from .config import Settings, repository_for
+from .diagnostics import business_operation_json
+from .models import ServiceError
+from .routing import bank_list, bank_target, multi_bank_discovery
+from .security import bearer_credential
+from .tenant import ContextDBTenantExtension
+
+if TYPE_CHECKING:
+    from hindsight_api import MemoryEngine
+
+
+class ContextDBMCPExtension(MCPExtension):
+    def register_tools(self, mcp: FastMCP, memory: MemoryEngine) -> None:
+        mcp.add_middleware(ContextDBMCPRouting(memory, Settings.from_environment()))
+
+
+class ContextDBMCPRouting(Middleware):
+    def __init__(self, memory: MemoryEngine, settings: Settings) -> None:
+        self.memory = memory
+        self.settings = settings
+
+    async def on_request(self, context: MiddlewareContext[Any], call_next: CallNext[Any, Any]) -> Any:
+        # Stateful MCP runs handlers outside the HTTP response task. Restore only
+        # our transport lifetime here; TenantExtension resolves current identity
+        # from the public HTTP request when native engine authentication runs.
+        request = get_http_request()
+        restore = request.scope.get("hindsight.request_context_restore")
+        if restore is None:
+            raise ToolError("ContextDB requires its transport admission entrypoint")
+        factory = cast(Callable[[], AbstractContextManager[None]], restore)
+        with factory():
+            return await call_next(context)
+
+    async def on_list_tools(
+        self, context: MiddlewareContext[mt.ListToolsRequest], call_next: CallNext[mt.ListToolsRequest, Sequence[Tool]]
+    ) -> Sequence[Tool]:
+        from hindsight_api.api.mcp import _current_bank_id
+
+        request = get_http_request()
+        credential = bearer_credential(request.scope["headers"])
+        repository = await repository_for(self.memory, self.settings)
+        try:
+            principal = await repository.authenticate(credential)
+            spaces = await repository.visible_workspaces(principal)
+            if not spaces:
+                return []
+            # Native FastMCP 3 wraps list_tools outside its middleware, then
+            # filters again after this ContextVar scope has exited. Keep only
+            # the current HTTP message's discovery intent in its trusted scope.
+            request.scope["contextdb.mcp_discovery"] = True
+            default = request.scope.get("contextdb.mcp_path_bank") or spaces[0].bank_id
+            token = _current_bank_id.set(default)
+            try:
+                with bank_target(default), multi_bank_discovery(not request.scope.get("contextdb.mcp_path_bank")):
+                    return await call_next(context)
+            finally:
+                _current_bank_id.reset(token)
+        except ServiceError as error:
+            raise ToolError(error.message) from None
+
+    async def on_call_tool(
+        self,
+        context: MiddlewareContext[mt.CallToolRequestParams],
+        call_next: CallNext[mt.CallToolRequestParams, ToolResult],
+    ) -> ToolResult:
+        request = get_http_request()
+        request.scope["contextdb.mcp_discovery"] = False
+        repository = await repository_for(self.memory, self.settings)
+        credential = bearer_credential(request.scope["headers"])
+        try:
+            # Obtain the CURRENT message's credential, never the initialize
+            # task's ContextVars. TenantExtension rechecks the HTTP credential.
+            principal = await repository.authenticate(credential)
+            if context.message.name == "list_banks":
+                from pydantic import BaseModel, Field
+
+                class ListArguments(BaseModel):
+                    query: str | None = None
+                    limit: int = Field(default=100, ge=0, le=1000)
+                    offset: int = Field(default=0, ge=0)
+
+                arguments = ListArguments.model_validate(context.message.arguments or {})
+                page = await bank_list(
+                    self.memory,
+                    repository,
+                    credential,
+                    query=arguments.query,
+                    limit=arguments.limit,
+                    offset=arguments.offset,
+                    bank_id=request.scope.get("contextdb.mcp_path_bank"),
+                )
+                serialized = page.model_dump_json()
+                # Native list_banks returns str: FastMCP 3 wraps its structured
+                # output under result while retaining the JSON text content.
+                return ToolResult(content=serialized, structured_content={"result": serialized})
+            arguments = context.message.arguments or {}
+            path_bank = request.scope.get("contextdb.mcp_path_bank")
+            supplied = arguments.get("bank_id")
+            if path_bank and supplied is not None and supplied != path_bank:
+                raise ServiceError(403, "bank_mismatch", "Single-Bank MCP cannot switch its Bank")
+            from hindsight_api.api.mcp import get_current_bank_id
+
+            # Native multi-bank clients may provide X-Bank-Id as a session
+            # default instead of repeating bank_id in each tool argument.
+            bank_id = path_bank or supplied or request.headers.get("x-bank-id") or get_current_bank_id()
+            if not isinstance(bank_id, str):
+                raise ServiceError(400, "bank_required", "Specify bank_id or use /mcp/{bank_id}")
+            tenant = self.memory.tenant_extension
+            if not isinstance(tenant, ContextDBTenantExtension) or tenant.admission_guard is None:
+                raise RuntimeError("ContextDB MCP requires the transport admission extension")
+            from hindsight_api.api.mcp import _current_bank_id
+
+            with bank_target(bank_id, clear_memories=context.message.name == "clear_memories"):
+                async with tenant.admission_guard.enter(credential or "", bank_id) as admitted:
+                    bank_token = _current_bank_id.set(bank_id)
+                    original = request.scope.get("hindsight.request_context_failure")
+
+                    def report_failure() -> None:
+                        admitted.failed = True
+
+                    request.scope["hindsight.request_context_failure"] = report_failure
+                    try:
+                        with restore_admission(admitted):
+                            result = await call_next(context)
+                            if principal.role.value != "admin" and context.message.name in {
+                                "get_operation",
+                                "list_operations",
+                            }:
+                                return _business_status_result(result)
+                            return result
+                    finally:
+                        _current_bank_id.reset(bank_token)
+                        if original is None:
+                            request.scope.pop("hindsight.request_context_failure", None)
+                        else:
+                            request.scope["hindsight.request_context_failure"] = original
+        except ServiceError as error:
+            raise ToolError(error.message) from None
+
+
+def _business_status_result(result: ToolResult) -> ToolResult:
+    """Cover both single-bank dictionaries and multi-bank JSON-string results."""
+    import json
+
+    content = []
+    try:
+        for block in result.content:
+            if isinstance(block, mt.TextContent):
+                content.append(block.model_copy(update={"text": business_operation_json(block.text)}))
+            else:
+                content.append(block)
+        structured = result.structured_content
+        if structured is not None:
+            if set(structured) == {"result"} and isinstance(structured["result"], str):
+                structured = {"result": business_operation_json(structured["result"])}
+            else:
+                structured = json.loads(business_operation_json(json.dumps(structured)))
+        return ToolResult(content=content, structured_content=structured)
+    except ValueError:
+        raise ToolError("Task status response unavailable") from None
diff --git a/hindsight-extensions/contextdb-service/hindsight_ext_contextdb/migrations.py b/hindsight-extensions/contextdb-service/hindsight_ext_contextdb/migrations.py
