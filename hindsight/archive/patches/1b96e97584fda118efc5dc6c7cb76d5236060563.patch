+# First release: one runtime container; API's in-process Worker + Node UI.
+x-common: &common
+  image: ${CONTEXTDB_IMAGE:?Set an immutable own-build image tag or digest}
+  user: "${CONTEXTDB_UID:-10001}:${CONTEXTDB_GID:-10001}"
+  restart: unless-stopped
+  init: true
+  read_only: true
+  stop_grace_period: 45s
+  tmpfs:
+    - /tmp:mode=1777,size=256m
+    - /app/hindsight-control-plane/standalone/.next/cache:mode=1777,size=64m
+  environment:
+    CONTEXTDB_DEPLOY_DIR: /var/lib/contextdb
+    CONTEXTDB_COMBINED: "1"
+  logging:
+    driver: json-file
+    options:
+      max-size: "20m"
+      max-file: "5"
+
+services:
+  initialize:
+    <<: *common
+    profiles: [initialize]
+    restart: "no"
+    command: [init]
+    volumes:
+      - ${CONTEXTDB_DEPLOY_DIR}:/var/lib/contextdb:rw
+  hindsight:
+    <<: *common
+    command: [all]
+    cpus: "${CONTEXTDB_CPUS:-2}"
+    mem_limit: ${CONTEXTDB_MEMORY:-4g}
+    volumes:
+      - ${CONTEXTDB_DEPLOY_DIR:?Set the private persistent deployment directory}/api.env:/var/lib/contextdb/api.env:ro
+      - ${CONTEXTDB_DEPLOY_DIR}/api-secrets.json:/var/lib/contextdb/api-secrets.json:ro
+      - ${CONTEXTDB_DEPLOY_DIR}/ui.env:/var/lib/contextdb/ui.env:ro
+      - ${CONTEXTDB_DEPLOY_DIR}/ui-secrets.json:/var/lib/contextdb/ui-secrets.json:ro
+    ports:
+      - "${CONTEXTDB_API_PORT:-8888}:${CONTEXTDB_API_PORT:-8888}"
+      - "${CONTEXTDB_UI_PORT:-9999}:${CONTEXTDB_UI_PORT:-9999}"
+    healthcheck:
+      test: [CMD-SHELL, '. /var/lib/contextdb/api.env; /app/.venv/bin/python -m hindsight_api.http_probe "http://127.0.0.1:$$HINDSIGHT_API_PORT/health/ready" 3 && (. /var/lib/contextdb/ui.env; /app/.venv/bin/python -m hindsight_api.http_probe "http://127.0.0.1:$$HINDSIGHT_CP_PORT/api/health" 3)']
+      interval: 15s
+      timeout: 8s
+      retries: 12
+      start_period: 60s
