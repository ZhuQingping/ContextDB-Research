--- /dev/null
+++ b/hindsight-extensions/contextdb-service/hindsight_ext_contextdb/tenant.py
@@ -0,0 +1,303 @@
+"""Dynamic member credentials select a workspace schema on REST and MCP alike."""
+
+import asyncio
+from collections import OrderedDict
+from collections.abc import AsyncIterator
+from contextlib import asynccontextmanager
+from typing import TYPE_CHECKING
+
+import asyncpg
+from hindsight_api.extensions.operation_validator import OperationValidationError
+from hindsight_api.extensions.tenant import AuthenticationError, Tenant, TenantContext, TenantExtension
+from hindsight_api.models import RequestContext
+
+from .config import Settings, repository_for
+from .models import ServiceError
+from .repository import Repository
+
+if TYPE_CHECKING:
+    from .admission import AdmissionGuard
+
+
+class ContextDBTenantExtension(TenantExtension):
+    def __init__(self, config: dict[str, str]) -> None:
+        super().__init__(config)
+        self.settings = Settings.from_environment()
+        self.metadata_pool: asyncpg.Pool | None = None
+        self._metadata_lock = asyncio.Lock()
+        self.http_lifecycle_owner = False
+        self.admission_guard: AdmissionGuard | None = None
+        self.transport_guard_installed = False
+        from .admission import executor_identity
+
+        self.queue_owner_id = executor_identity("queue")
+        self._bank_generations: OrderedDict[tuple[str, str], str] = OrderedDict()
+        self._bank_generation_lock = asyncio.Lock()
+
+    async def _refresh_bank_generation(self, schema: str, bank_id: str, workspace_id: str) -> None:
+        """Keep native process-local profile/config entries within one workspace generation.
+
+        Another API replica can DROP/recreate the same readable namespace while
+        this process still holds its previous profile/config for the native TTL.
+        Admission fences old executors; this local identity check fences their
+        cached data without disabling normal same-generation cache hits.
+        """
+        from hindsight_api.engine import bank_info_cache
+        from hindsight_api.engine.memory_engine import _current_schema
+
+        key = (schema, bank_id)
+        async with self._bank_generation_lock:
+            if self._bank_generations.get(key) != workspace_id:
+                token = _current_schema.set(schema)
+                try:
+                    await bank_info_cache.invalidate(bank_id)
+                finally:
+                    _current_schema.reset(token)
+                self._bank_generations[key] = workspace_id
+            self._bank_generations.move_to_end(key)
+            # Match the native default cache bound. Eviction is conservative:
+            # the next visit is a first visit and invalidates again.
+            while len(self._bank_generations) > 2048:
+                self._bank_generations.popitem(last=False)
+
+    async def control_repository(self) -> Repository:
+        # Management can wait for an admitted request. It must not occupy the
+        # engine pool that request needs to finish. This is a separate connection
+        # budget to the SAME dedicated RDS PG, not a second metadata database.
+        if self.metadata_pool is None:
+            async with self._metadata_lock:
+                if self.metadata_pool is None:
+                    url = getattr(self._engine(), "db_url", None)
+                    if not isinstance(url, str):
+                        raise RuntimeError("ContextDB metadata requires a resolved PostgreSQL URL")
+                    self.metadata_pool = await asyncpg.create_pool(
+                        url,
+                        min_size=0,
+                        max_size=self.settings.metadata_pool_max_size,
+                        server_settings={"application_name": "contextdb_metadata"},
+                    )
+        assert self.metadata_pool is not None
+        return Repository(
+            self.metadata_pool,
+            self.settings.instance_id,
+            self.settings.cloud_tenant_id,
+            self.settings.pepper,
+            operation_retention_hours=self.settings.operation_retention_hours,
+        )
+
+    async def on_shutdown(self) -> None:
+        # Native HTTP shuts down tenant hooks before HttpExtension hooks. The
+        # latter must stop its lifecycle executor before closing this pool.
+        if not self.http_lifecycle_owner:
+            await self.close_control_pool()
+
+    async def close_control_pool(self) -> None:
+        if self.metadata_pool is not None:
+            await self.metadata_pool.close()
+            self.metadata_pool = None
+
+    async def on_startup(self) -> None:
+        self._require_transport_guard()
+        repository = await repository_for(self._engine(), self.settings)
+        await repository.verify_schema()
+
+    def _require_transport_guard(self) -> None:
+        if not self.transport_guard_installed:
+            raise RuntimeError(
+                "ContextDB requires the hindsight_ext_contextdb.asgi:create_app admission extension entrypoint"
+            )
+
+    def _engine(self) -> object:
+        from .validator import ContextDBOperationValidator
+
+        engine = self.context.get_memory_engine()
+        # Native startup migrations run outside our generation/admission guard.
+        # A stale initialization thread could otherwise outlive DROP/recreate of
+        # the same readable schema. Upgrade existing schemas offline; lifecycle
+        # provisioning still runs explicit, durably fenced migrations at runtime.
+        if getattr(engine, "_run_migrations", False) is True:
+            raise RuntimeError(
+                "ContextDB requires HINDSIGHT_API_RUN_MIGRATIONS_ON_STARTUP=false; upgrade existing schemas offline"
+            )
+        if not isinstance(getattr(engine, "_operation_validator", None), ContextDBOperationValidator):
+            raise RuntimeError("ContextDB tenant routing requires its bank/operation validator")
+        return engine
+
+    @staticmethod
+    def _current_mcp_credential(context: RequestContext) -> None:
+        from fastmcp.server.dependencies import get_http_request
+
+        from .security import bearer_credential
+
+        try:
+            request = get_http_request()
+        except RuntimeError:
+            return  # REST and Worker execution have no FastMCP HTTP request.
+        context.api_key = bearer_credential(request.scope["headers"])
+
+    async def authenticate(self, context: RequestContext) -> TenantContext:
+        from .routing import target_bank
+
+        engine = self._engine()
+        self._require_transport_guard()
+        self._current_mcp_credential(context)
+        repository = await repository_for(engine, self.settings)
+        bank_id = target_bank()
+        try:
+            if not bank_id:
+                raise ServiceError(403, "bank_required", "A registered Bank target is required")
+            principal = await repository.authenticate(context.api_key, bank_id, record_use=True)
+        except ServiceError as error:
+            raise AuthenticationError(error.message) from None
+        context.api_key_id = principal.key_id
+        context.tenant_id = principal.workspace_id
+        context.allowed_bank_ids = [bank_id]
+        assert principal.schema_name is not None
+        assert principal.workspace_id is not None
+        await self._refresh_bank_generation(principal.schema_name, bank_id, principal.workspace_id)
+        return TenantContext(principal.schema_name)
+
+    async def authenticate_mcp(self, context: RequestContext) -> TenantContext:
+        # initialize/tools-list carry no tool Bank. Authenticate the CURRENT
+        # message now, then the MCP extension selects and rechecks the actual
+        # tool Bank. The metadata schema is an explicit no-data sentinel when
+        # the Key has no visible spaces; it is never a default memory schema.
+        repository = await repository_for(self._engine(), self.settings)
+        try:
+            principal = await repository.authenticate(context.api_key, record_use=True)
+            spaces = await repository.visible_workspaces(principal)
+        except ServiceError as error:
+            raise AuthenticationError(error.message) from None
+        context.api_key_id = principal.key_id
+        context.tenant_id = self.settings.cloud_tenant_id
+        return TenantContext(spaces[0].schema_name if spaces else "ctxdb_meta")
+
+    async def list_tenants(self) -> list[Tenant]:
+        engine = self._engine()
+        if getattr(engine, "_initialized", None) is False:
+            # Core calls discovery before it has opened its pool. _get_pool() here
+            # would initialize -> discover -> initialize forever. A short-lived
+            # metadata connection closes before migration; runtime uses the pool.
+            url = getattr(engine, "db_url", None)
+            if not isinstance(url, str) or not url.startswith("postgresql"):
+                raise RuntimeError("ContextDB requires a resolved PostgreSQL deployment URL")
+            connection = await asyncpg.connect(url.replace("postgresql+asyncpg://", "postgresql://"))
+            try:
+                workspaces = await Repository.discover_workspaces(
+                    connection, self.settings.instance_id, self.settings.cloud_tenant_id
+                )
+            finally:
+                await connection.close()
+        else:
+            repository = await repository_for(engine, self.settings)
+            workspaces = await repository.worker_workspaces()
+        # Deleting spaces remain discoverable so already accepted jobs can
+        # drain; no user request is admitted while they are deleting.
+        return [Tenant(schema=item.schema_name, tenant_id=item.workspace_id) for item in workspaces]
+
+    async def get_allowed_config_fields(self, context: RequestContext, bank_id: str) -> set[str] | None:
+        from hindsight_api.config import HindsightConfig
+
+        # Preserve the native public read surface; the resolver already strips
+        # credentials and rejects static writes before applying this allow-list.
+        allowed = (HindsightConfig.get_configurable_fields() | HindsightConfig.get_static_fields()) - {
+            "audit_log_enabled"
+        }
+        if context.internal:
+            return allowed
+        self._current_mcp_credential(context)
+        repository = await repository_for(self._engine(), self.settings)
+        try:
+            await repository.authenticate_admin(context.api_key)
+            await repository.authenticate(context.api_key, bank_id)
+        except ServiceError:
+            return set()
+        return allowed
+
+    @asynccontextmanager
+    async def async_execution_scope(
+        self, schema: str | None, bank_id: str, tenant_id: str | None
+    ) -> AsyncIterator[None]:
+        from .admission import durable_admission
+
+        repository = await self.control_repository()
+        if schema is None or tenant_id is None:
+            raise ServiceError(409, "execution_generation", "Queued task lacks a workspace generation")
+        workspace = await repository.internal_workspace(bank_id, schema)
+        if workspace.workspace_id != tenant_id:
+            raise ServiceError(409, "execution_generation", "Queued task belongs to another workspace generation")
+        # register_admission locks this immutable UUID/schema and commits before
+        # execution. If deletion/recreation races the lookup, old UUID admission
+        # fails instead of joining the successor's identical physical namespace.
+        # Deleting spaces still drain their already accepted jobs.
+        async with durable_admission(repository, tenant_id, schema, "queue", self.queue_owner_id) as ticket:
+            await self._refresh_bank_generation(schema, bank_id, tenant_id)
+            ticket.work_started = True
+            yield
+
+    @asynccontextmanager
+    async def async_submission_scope(self, schema: str, bank_id: str) -> AsyncIterator[None]:
+        from .admission import durable_admission, is_admitted
+
+        # An HTTP request already owns the shared lock. Taking it again on a
+        # second connection can deadlock behind a waiting control-plane writer.
+        if is_admitted(schema, bank_id):
+            yield
+            return
+        repository = await self.control_repository()
+        try:
+            workspace = await repository.internal_workspace(bank_id, schema)
+            async with durable_admission(
+                repository, workspace.workspace_id, schema, "queue", self.queue_owner_id
+            ) as ticket:
+                await self._refresh_bank_generation(schema, bank_id, workspace.workspace_id)
+                async with self._queue_state_scope(repository, schema, bank_id):
+                    ticket.work_started = True
+                    yield
+        except ServiceError as error:
+            raise OperationValidationError(error.message, status_code=error.status) from None
+
+    @asynccontextmanager
+    async def _queue_state_scope(self, repository: Repository, schema: str, bank_id: str) -> AsyncIterator[None]:
+        from .admission import bank_initialization, protected_transaction
+
+        # Enter BEFORE acquiring any engine connection. A queued control writer
+        # may block new shared locks; doing that inside the engine transaction
+        # would exhaust its pool and prevent the older HTTP reader from leaving.
+        async with protected_transaction(repository.pool) as connection:
+            await Repository._verify_binding(connection, self.settings.instance_id, self.settings.cloud_tenant_id)
+            row = await connection.fetchrow(
+                "SELECT workspace_id,state FROM ctxdb_meta.workspaces WHERE bank_id=$1 AND schema_name=$2 FOR KEY SHARE",
+                bank_id,
+                schema,
+            )
+            initialization = bank_initialization(schema, bank_id)
+            if row is not None and row["state"] == "creating" and initialization is not None:
+                # The workspace and operation locks cover only the short native
+                # queue INSERT, never migration DDL. A stale provisioning task
+                # cannot submit a default template after another owner takes over.
+                owned = await repository.operation_is_owned(
+                    initialization.operation_id,
+                    initialization.lease_token,
+                    "create_workspace",
+                    row["workspace_id"],
+                    connection=connection,
+                    lock=True,
+                )
+                if not owned:
+                    raise OperationValidationError("Workspace initialization lease was lost", status_code=409)
+                yield
+                return
+            if row is None or row["state"] not in {"active", "deleting"}:
+                raise OperationValidationError("Workspace does not admit background submissions", status_code=409)
+            if row["state"] != "active":
+                # A running job may enqueue a continuation before its processing row
+                # completes. A periodic sweep with no accepted parent cannot reopen
+                # the queue after the drain observes it empty.
+                processing = await connection.fetchval(
+                    f"SELECT 1 FROM \"{schema}\".async_operations WHERE bank_id=$1 AND status='processing' LIMIT 1",
+                    bank_id,
+                )
+                if not processing:
+                    raise OperationValidationError("Inactive workspace queue is closed", status_code=409)
+            yield
diff --git a/hindsight-extensions/contextdb-service/hindsight_ext_contextdb/validator.py b/hindsight-extensions/contextdb-service/hindsight_ext_contextdb/validator.py
new file mode 100644
index 0000000000000000000000000000000000000000..84a6c1476355d02a05902da690129d13896bb66d
--- /dev/null
+++ b/hindsight-extensions/contextdb-service/hindsight_ext_contextdb/validator.py
@@ -0,0 +1,346 @@
+"""Bank and operation policy shared by REST, MCP and already accepted worker jobs.
+
+Scopes are enforced at engine hooks, not just by hiding MCP tools. Internal jobs
+do not reauthenticate a revoked customer Key, but they must still match the
+registered bank/schema. Only lifecycle calls carry a purpose that permits Bank
+creation/deletion; being an internal worker is not blanket management authority.
+"""
+
+from hindsight_api.extensions.operation_validator import (
+    BankListScope,
+    BankReadContext,
+    BankReadOperation,
+    BankWriteContext,
+    BankWriteOperation,
+    ConsolidateContext,
+    CreateBankContext,
+    MentalModelGetContext,
+    MentalModelRefreshContext,
+    OperationValidatorExtension,
+    PrecheckContext,
+    PrecheckOperation,
+    RecallContext,
+    ReflectContext,
+    RetainContext,
+    RetainResult,
+    ValidationResult,
+)
+from hindsight_api.models import RequestContext
+
+from .config import Settings, repository_for
+from .models import Scope, ServiceError
+
+_KNOWLEDGE_READS = frozenset(
+    {
+        BankReadOperation.GET_KNOWLEDGE_BASE_TREE,
+        BankReadOperation.GET_KNOWLEDGE_PAGE,
+        BankReadOperation.SEARCH_KNOWLEDGE_BASE,
+        BankReadOperation.EXPORT_KNOWLEDGE_BASE,
+    }
+)
+_MEMORY_WRITES = frozenset(
+    {
+        BankWriteOperation.UPDATE_MEMORY_UNIT,
+        BankWriteOperation.UPDATE_DOCUMENT,
+        BankWriteOperation.DELETE_DOCUMENT,
+        BankWriteOperation.REPROCESS_DOCUMENT,
+        BankWriteOperation.IMPORT_DOCUMENTS,
+        BankWriteOperation.CREATE_MENTAL_MODEL,
+        BankWriteOperation.UPDATE_MENTAL_MODEL,
+        BankWriteOperation.DELETE_MENTAL_MODEL,
+        BankWriteOperation.CREATE_DIRECTIVE,
+        BankWriteOperation.UPDATE_DIRECTIVE,
+        BankWriteOperation.DELETE_DIRECTIVE,
+        BankWriteOperation.CREATE_KNOWLEDGE_FOLDER,
+        BankWriteOperation.CREATE_KNOWLEDGE_PAGE,
+        BankWriteOperation.UPDATE_KNOWLEDGE_PAGE,
+        BankWriteOperation.RENAME_KNOWLEDGE_NODE,
+        BankWriteOperation.MOVE_KNOWLEDGE_NODE,
+        BankWriteOperation.DELETE_KNOWLEDGE_NODE,
+        # Native successful retains/edits enqueue these using the original caller
+        # context. Refusing them silently disables the background half of memory.
+        BankWriteOperation.SUBMIT_ASYNC_CONSOLIDATION,
+        BankWriteOperation.SUBMIT_ASYNC_GRAPH_MAINTENANCE,
+        BankWriteOperation.SUBMIT_ASYNC_VECTOR_INDEX_MAINTENANCE,
+    }
+)
+
+
+class ContextDBOperationValidator(OperationValidatorExtension):
+    def __init__(self, config: dict[str, str]) -> None:
+        super().__init__(config)
+        self.settings = Settings.from_environment()
+
+    async def _authorize(
+        self,
+        context: RequestContext,
+        bank_id: str,
+        scope: Scope | None,
+        *,
+        lifecycle_purpose: str | None = None,
+    ) -> ValidationResult:
+        # Resolve lazily: importing the engine eagerly while its extension slots
+        # are being constructed would create a circular import.
+        from hindsight_api.engine.memory_engine import get_current_bank_id, get_current_schema
+
+        repository = await repository_for(self.context.get_memory_engine(), self.settings)
+        try:
+            if context.internal:
+                workspace = await repository.internal_workspace(bank_id, get_current_schema())
+                if context.tenant_id is not None and context.tenant_id != workspace.workspace_id:
+                    return ValidationResult.reject(
+                        "Internal task belongs to another workspace generation", status_code=409
+                    )
+                purpose = context.extra_headers.get("ctxdb-internal-purpose")
+                if lifecycle_purpose and purpose != lifecycle_purpose:
+                    return ValidationResult.reject("Bank management requires a purpose-limited lifecycle context")
+                if purpose is not None and (
+                    purpose not in {"create_workspace", "delete_workspace"}
+                    or not await repository.operation_is_owned(
+                        context.extra_headers.get("ctxdb-operation-id", ""),
+                        context.extra_headers.get("ctxdb-lease-token", ""),
+                        purpose,
+                        workspace.workspace_id,
+                    )
+                ):
+                    return ValidationResult.reject("Workspace operation lease was lost", status_code=409)
+                if workspace.state in {"creating", "failed"} and purpose is None:
+                    return ValidationResult.reject("Workspace is not ready for background memory operations")
+                if (
+                    workspace.state in {"deleting"}
+                    and scope == Scope.MEMORY_WRITE
+                    and not context.api_key_id
+                    and not context.user_initiated
+                    and purpose is None
+                    and get_current_bank_id() != bank_id
+                ):
+                    return ValidationResult.reject("Periodic work cannot enqueue new jobs into an inactive workspace")
+                return ValidationResult.accept()
+            if lifecycle_purpose:
+                return ValidationResult.reject("Business Keys cannot manage Banks")
+            principal = await repository.authenticate(context.api_key, bank_id)
+            # Tenant resolution must precede every hook. Rechecking this binding
+            # also rejects MCP/static-token and cross-schema adapter mistakes.
+            if get_current_schema() != principal.schema_name:
+                return ValidationResult.reject("Authenticated schema does not match this Key")
+            if scope and scope not in principal.scopes:
+                return ValidationResult.reject("Key lacks the required operation scope")
+            from .admission import mark_engine_started
+
+            mark_engine_started()
+            return ValidationResult.accept()
+        except ServiceError as error:
+            return ValidationResult.reject(error.message, status_code=error.status)
+
+    async def precheck(self, ctx: PrecheckContext) -> ValidationResult:
+        scope = {
+            PrecheckOperation.RECALL: Scope.MEMORY_READ,
+            PrecheckOperation.REFLECT: Scope.REFLECT,
+        }.get(ctx.operation, Scope.MEMORY_WRITE)
+        return await self._authorize(ctx.request_context, ctx.bank_id, scope)
+
+    async def validate_retain(self, ctx: RetainContext) -> ValidationResult:
+        return await self._authorize(ctx.request_context, ctx.bank_id, Scope.MEMORY_WRITE)
+
+    async def validate_recall(self, ctx: RecallContext) -> ValidationResult:
+        return await self._authorize(ctx.request_context, ctx.bank_id, Scope.MEMORY_READ)
+
+    async def validate_reflect(self, ctx: ReflectContext) -> ValidationResult:
+        return await self._authorize(ctx.request_context, ctx.bank_id, Scope.REFLECT)
+
+    async def validate_consolidate(self, ctx: ConsolidateContext) -> ValidationResult:
+        return await self._authorize(ctx.request_context, ctx.bank_id, Scope.MEMORY_WRITE)
+
+    async def validate_bank_read(self, ctx: BankReadContext) -> ValidationResult:
+        if not ctx.request_context.internal and ctx.operation in {
+            BankReadOperation.LIST_WEBHOOKS,
+            BankReadOperation.LIST_WEBHOOK_DELIVERIES,
+        }:
+            # Delivery headers/responses can contain operator credentials even
+            # when the signing secret itself is redacted by the native API.
+            repository = await repository_for(self.context.get_memory_engine(), self.settings)
+            try:
+                await repository.authenticate_admin(ctx.request_context.api_key)
+            except ServiceError as error:
+                return ValidationResult.reject(error.message, status_code=error.status)
+        scope = Scope.KNOWLEDGE_READ if ctx.operation in _KNOWLEDGE_READS else Scope.MEMORY_READ
+        # Profile reads also authorize audit/LLM trace/archive routes in core.
+        # Knowledge reads have their own gates and must not inherit that access.
+        return await self._authorize(ctx.request_context, ctx.bank_id, scope)
+
+    async def validate_bank_write(self, ctx: BankWriteContext) -> ValidationResult:
+        if ctx.operation == BankWriteOperation.DELETE_BANK:
+            from .routing import content_clear
+
+            if not ctx.request_context.internal and content_clear():
+                # Native clear_memories shares DELETE_BANK with actual teardown.
+                # Only trusted transport/tool paths set this flag; client headers
+                # cannot grant Bank deletion through the content-clear entry.
+                repository = await repository_for(self.context.get_memory_engine(), self.settings)
+                try:
+                    await repository.authenticate_admin(ctx.request_context.api_key)
+                except ServiceError as error:
+                    return ValidationResult.reject(error.message, status_code=error.status)
+                return await self._authorize(ctx.request_context, ctx.bank_id, Scope.MEMORY_WRITE)
+            return await self._authorize(ctx.request_context, ctx.bank_id, None, lifecycle_purpose="delete_workspace")
+        if ctx.request_context.internal:
+            scope = (
+                Scope.MEMORY_WRITE
+                if ctx.operation
+                in {
+                    BankWriteOperation.SUBMIT_ASYNC_CONSOLIDATION,
+                    BankWriteOperation.SUBMIT_ASYNC_GRAPH_MAINTENANCE,
+                    BankWriteOperation.SUBMIT_ASYNC_VECTOR_INDEX_MAINTENANCE,
+                }
+                else None
+            )
+            return await self._authorize(ctx.request_context, ctx.bank_id, scope)
+        admin_operations = {
+            BankWriteOperation.UPDATE_BANK_CONFIG,
+            BankWriteOperation.UPDATE_BANK_DISPOSITION,
+            BankWriteOperation.SET_BANK_MISSION,
+            BankWriteOperation.MERGE_BANK_MISSION,
+            BankWriteOperation.RESET_BANK_CONFIG,
+            BankWriteOperation.CANCEL_OPERATION,
+            BankWriteOperation.DELETE_OPERATION,
+            BankWriteOperation.RETRY_OPERATION,
+            BankWriteOperation.RUN_CONSOLIDATION,
+            BankWriteOperation.RETRY_FAILED_CONSOLIDATION,
+            BankWriteOperation.CLEAR_OBSERVATIONS,
+            BankWriteOperation.CLEAR_OBSERVATIONS_FOR_MEMORY,
+            BankWriteOperation.CLEAR_MENTAL_MODEL,
+        }
+        if ctx.operation in admin_operations:
+            repository = await repository_for(self.context.get_memory_engine(), self.settings)
+            try:
+                await repository.authenticate_admin(ctx.request_context.api_key)
+            except ServiceError as error:
+                return ValidationResult.reject(error.message, status_code=error.status)
+            return await self._authorize(ctx.request_context, ctx.bank_id, None)
+        if ctx.operation not in _MEMORY_WRITES:
+            return ValidationResult.reject("Use the workspace management API for this lifecycle operation")
+        return await self._authorize(ctx.request_context, ctx.bank_id, Scope.MEMORY_WRITE)
+
+    async def on_retain_complete(self, result: RetainResult) -> None:
+        if not result.success and result.error == "append_conflict" and not result.request_context.internal:
+            from .admission import mark_retain_rejected
+
+            mark_retain_rejected(result.bank_id)
+
+    async def validate_create_bank(self, ctx: CreateBankContext) -> ValidationResult:
+        return await self._authorize(ctx.request_context, ctx.bank_id, None, lifecycle_purpose="create_workspace")
+
+    async def validate_mental_model_get(self, ctx: MentalModelGetContext) -> ValidationResult:
+        return await self._authorize(ctx.request_context, ctx.bank_id, Scope.MEMORY_READ)
+
+    async def validate_mental_model_refresh(self, ctx: MentalModelRefreshContext) -> ValidationResult:
+        return await self._authorize(ctx.request_context, ctx.bank_id, Scope.MEMORY_WRITE)
+
+    async def bank_list_scope(self, request_context: RequestContext) -> BankListScope:
+        repository = await repository_for(self.context.get_memory_engine(), self.settings)
+        if request_context.internal:
+            from hindsight_api.engine.memory_engine import get_current_schema
+
+            # Maintenance may enumerate banks without a customer credential.
+            # Deleting workspaces drain queued jobs, but get no new sweep.
+            workspace = await repository.maintenance_workspace(get_current_schema())
+            return BankListScope(bank_ids=[workspace.bank_id] if workspace else [])
+        from .routing import target_bank
+
+        bank_id = target_bank()
+        if not bank_id:
+            return BankListScope(bank_ids=[])
+        principal = await repository.authenticate(request_context.api_key, bank_id)
+        return BankListScope(bank_ids=[bank_id] if Scope.MEMORY_READ in principal.scopes else [])
+
+    async def filter_mcp_tools(
+        self,
+        bank_id: str,
+        request_context: RequestContext,
+        tools: frozenset[str],
+    ) -> frozenset[str]:
+        repository = await repository_for(self.context.get_memory_engine(), self.settings)
+        try:
+            from fastmcp.server.dependencies import get_http_request
+
+            from .routing import is_multi_bank_discovery
+            from .security import bearer_credential
+
+            credential = request_context.api_key
+            discovery = is_multi_bank_discovery()
+            target = bank_id
+            try:
+                request = get_http_request()
+            except RuntimeError:
+                request = None
+            if request is not None:
+                # Native list_tools filters once more after its middleware has
+                # restored ContextVars. Scope belongs to this actual message,
+                # unlike a stateful session's initialization identity.
+                credential = bearer_credential(request.scope["headers"])
+                path_bank = request.scope.get("contextdb.mcp_path_bank")
+                target = path_bank or target
+                discovery = bool(request.scope.get("contextdb.mcp_discovery")) and not path_bank
+            principal = await repository.authenticate(credential)
+            if discovery:
+                # Discovery may advertise the union, but execution always sets
+                # the actual target and derives scopes for that workspace only.
+                spaces = await repository.visible_workspaces(principal)
+                scopes: set[Scope] = set()
+                for space in spaces:
+                    scopes.update((await repository.select_workspace(principal, space.bank_id)).scopes)
+            else:
+                scopes = set((await repository.select_workspace(principal, target)).scopes)
+        except ServiceError:
+            return frozenset()
+        allowed: set[str] = set()
+        if Scope.MEMORY_READ in scopes:
+            allowed.update(
+                {
+                    "recall",
+                    "list_banks",
+                    "get_bank",
+                    "get_bank_stats",
+                    "list_directives",
+                    "list_operations",
+                    "get_operation",
+                    "list_tags",
+                    "list_memories",
+                    "get_memory",
+                    "list_documents",
+                    "get_document",
+                    "list_mental_models",
+                    "get_mental_model",
+                }
+            )
+        if Scope.MEMORY_WRITE in scopes:
+            allowed.update(
+                {
+                    "retain",
+                    "sync_retain",
+                    "update_memory",
+                    "invalidate_memory",
+                    "delete_document",
+                    "create_directive",
+                    "delete_directive",
+                    "update_mental_model",
+                    "delete_mental_model",
+                    "create_mental_model",
+                    "refresh_mental_model",
+                    "create_knowledge_folder",
+                    "create_knowledge_page",
+                    "update_knowledge_node",
+                    "delete_knowledge_node",
+                }
+            )
+        if Scope.REFLECT in scopes:
+            allowed.add("reflect")
+        if Scope.KNOWLEDGE_READ in scopes:
+            allowed.update({"get_knowledge_base_tree", "search_knowledge_base", "get_knowledge_page"})
+        if principal.role.value == "admin" and principal.access_mode == "all":
+            # Admin content/config tools remain available; resource lifecycle
+            # and name changes stay outside the native MCP surface.
+            from hindsight_api.mcp_tools import _ALL_TOOLS
+
+            allowed.update(_ALL_TOOLS - {"create_bank", "delete_bank", "update_bank"})
+        return tools & frozenset(allowed)
