+def test_legacy_mcp_shared_token_and_invalid_configuration_fail_closed(
+    configured: Settings, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    monkeypatch.setenv("HINDSIGHT_API_MCP_AUTH_TOKEN", "synthetic-shared-token")
