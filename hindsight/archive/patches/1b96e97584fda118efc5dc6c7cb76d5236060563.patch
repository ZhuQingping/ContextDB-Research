+                        {
+                            "name": "Idempotency-Key",
+                            "in": "header",
+                            "required": True,
+                            "schema": {
+                                "type": "string",
+                                "pattern": "^[A-Za-z0-9_-]{1,128}$",
+                                "minLength": 1,
+                                "maxLength": 128,
+                            },
