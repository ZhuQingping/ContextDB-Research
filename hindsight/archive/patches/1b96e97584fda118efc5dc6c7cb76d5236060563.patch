+    waiting = await repository.create_workspace(ADMIN, WorkspaceCreate(name="pending"), "pending", "pending")
+    await repository.pool.execute(
+        "UPDATE ctxdb_meta.management_operations SET updated_at=now()-interval '999 hours' WHERE operation_id=$1",
+        waiting.operation_id,
+    )
+    await repository.register_admission("1" * 32, "unknown", space.workspace_id, space.schema_name, "http")
+    await repository.pool.execute("UPDATE ctxdb_meta.request_admissions SET created_at=now()-interval '999 hours'")
+    assert await repository.prune_operations() == 1
+    assert (await repository.get_operation(ADMIN, waiting.operation_id)).state == "pending"
+    assert await repository.has_outstanding_admissions(space.workspace_id)
